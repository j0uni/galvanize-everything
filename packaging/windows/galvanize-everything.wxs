<?xml version="1.0" encoding="utf-8"?>
<!--
  Galvanize Everything MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build galvanize-everything.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc galvanize-everything.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\Galvanize Everything by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch Galvanize Everything" box. Installs a Start Menu shortcut and an
  App Paths entry (Win+R "galvanize-everything"), plus galvanize-everything-cli when HasCli=1. No file types are
  claimed: Galvanize Everything opens anything, so it never takes over another app's default.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for Galvanize Everything forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Galvanize Everything"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="8F69A8B5-4384-479B-B3FF-93C5374BCA51"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Galvanize Everything: find out how any software works" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Galvanize Everything is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="GalvanizeEverythingIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GalvanizeEverythingIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Galvanize Everything" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by GalvanizeEverythingApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Galvanize Everything" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Galvanize Everything" Level="1">
      <ComponentGroupRef Id="GalvanizeEverythingFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchGalvanizeEverything"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through galvanize-everything.en-us.wxl. -->
    <Property Id="GalvanizeEverythingVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Galvanize Everything $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Galvanize Everything" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#GalvanizeEverythingExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchGalvanizeEverything" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="GalvanizeEverythingFiles" Directory="INSTALLFOLDER">
      <Component Id="GalvanizeEverythingApp" Guid="60FCAC4D-3674-43B5-824E-D73D95F95627">
        <File Id="GalvanizeEverythingExe" Source="$(var.BinDir)\galvanize-everything.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Galvanize Everything"
              Description="Find out how any software works, then craft your own" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="GalvanizeEverythingIcon.exe" IconIndex="0" />
        </File>

        <!-- The "Open with" app list (any file) and the Run dialog (Win+R "galvanize-everything"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\galvanize-everything.exe" Name="FriendlyAppName" Value="Galvanize Everything" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\galvanize-everything.exe\shell\open\command" Value="&quot;[#GalvanizeEverythingExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\galvanize-everything.exe" Value="[#GalvanizeEverythingExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Galvanize Everything" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="GalvanizeEverythingCli">
        <File Id="GalvanizeEverythingCliExe" Source="$(var.BinDir)\galvanize-everything-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
